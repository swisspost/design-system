{
  "name": "@swisspost/design-system-cypress-config",
  "version": "10.5.0",
  "description": "Shared Cypress configuration for the Swiss Post Design System.",
  "author": "Swiss Post <design-system@post.ch>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/swisspost/design-system.git",
    "directory": "tooling/cypress"
  },
  "homepage": "https://design-system.post.ch",
  "bugs": {
    "url": "https://github.com/swisspost/design-system/issues"
  },
  "exports": {
    ".": "./dist/configs/base.js"
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "pnpm clean && tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@puppeteer/browsers": "3.2.2",
    "proxy-agent": "8.0.2"
  },
  "peerDependencies": {
    "cypress": ">=15.0.0"
  },
  "devDependencies": {
    "@swisspost/design-system-eslint-config": "workspace:10.5.0",
    "@swisspost/design-system-prettier-config": "workspace:10.5.0",
    "@swisspost/design-system-tsconfig": "workspace:10.5.0",
    "@types/node": "catalog:node",
    "cypress": "catalog:cypress",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "6.1.3",
    "typescript": "catalog:"
  },
  "prettier": "@swisspost/design-system-prettier-config",
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "design-system",
    "cypress"
  ]
}
