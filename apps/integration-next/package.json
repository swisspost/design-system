{
  "name": "@swisspost/design-system-integration-next",
  "version": "10.4.0",
  "description": "NextJS example integration of the Swiss Post Design System",
  "author": "Swiss Post <design-system@post.ch>",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/swisspost/design-system.git"
  },
  "homepage": "https://design-system.post.ch",
  "bugs": {
    "url": "https://github.com/swisspost/design-system/issues"
  },
  "scripts": {
    "start": "next dev",
    "build": "pnpm clean && pnpm typecheck && next build",
    "build:serve": "pnpm build && next start",
    "analyze": "next experimental-analyze",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "e2e": "pnpm exec playwright test",
    "e2e:watch": "pnpm exec playwright test --ui",
    "unit": "vitest run",
    "unit:watch": "vitest"
  },
  "dependencies": {
    "@swisspost/design-system-components-react": "workspace:10.4.0",
    "@swisspost/design-system-styles": "workspace:10.4.0",
    "next": "16.2.11",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@swisspost/design-system-components": "workspace:10.4.0",
    "@swisspost/design-system-eslint-config": "workspace:10.4.0",
    "@swisspost/design-system-prettier-config": "workspace:10.4.0",
    "@swisspost/design-system-tsconfig": "workspace:10.4.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "catalog:node",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "resolve.exports": "2.0.3",
    "rimraf": "6.1.3",
    "sass": "1.101.0",
    "tailwindcss": "4.3.1",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  },
  "prettier": "@swisspost/design-system-prettier-config",
  "keywords": [
    "nextjs",
    "swisspost",
    "design-system",
    "example"
  ]
}
