{
  "extends": "@swisspost/design-system-tsconfig/browser.tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "types": ["cypress", "@percy/cypress", "@swisspost/internet-header", "cypress-axe"],

    // Pre-existing debt. Drop once sources are clean.
    "noImplicitOverride": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": []
}
