{
  "extends": "@swisspost/design-system-tsconfig/browser.tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["vite/client"],
    "paths": {
      "@preview/*": ["./preview/*"],
      "@shell/*": ["./shell/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "./preview" },
    { "path": "./shell" },
    { "path": "./shared" },
    { "path": "./tsconfig.node.json" }
  ]
}
