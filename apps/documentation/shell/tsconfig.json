{
  "extends": "@swisspost/design-system-tsconfig/browser.tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.cache/tsc/shell.tsbuildinfo",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@shell/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "references": [{ "path": "../shared" }]
}
