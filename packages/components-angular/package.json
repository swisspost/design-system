{
  "name": "@swisspost/design-system-components-angular",
  "version": "10.4.0",
  "description": "Swiss Post Design System - Angular Wrapper Components",
  "author": "Swiss Post <design-system@post.ch>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/swisspost/design-system.git"
  },
  "homepage": "https://design-system.post.ch",
  "bugs": {
    "url": "https://github.com/swisspost/design-system/issues"
  },
  "publishConfig": {
    "directory": "./dist",
    "access": "public",
    "linkDirectory": true
  },
  "exports": {
    "./post-components.css": "./post-components.css"
  },
  "sideEffects": false,
  "scripts": {
    "ng": "ng",
    "build": "pnpm clean && ng build components",
    "typecheck": "tsc --noEmit",
    "postbuild": "copyfiles -f src/stencil-generated/post-components.css dist/",
    "clean": "rimraf dist .angular",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "dependencies": {
    "@swisspost/design-system-components": "workspace:10.4.0",
    "tslib": "catalog:angular"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular/build": "catalog:angular",
    "@angular/cli": "catalog:angular",
    "@angular/common": "catalog:angular",
    "@angular/compiler": "catalog:angular",
    "@angular/compiler-cli": "catalog:angular",
    "@angular/core": "catalog:angular",
    "@angular/forms": "catalog:angular",
    "@swisspost/design-system-eslint-config": "workspace:10.4.0",
    "@swisspost/design-system-prettier-config": "workspace:10.4.0",
    "@swisspost/design-system-tsconfig": "workspace:10.4.0",
    "angular-eslint": "catalog:angular",
    "copyfiles": "2.4.1",
    "eslint": "catalog:",
    "ng-packagr": "catalog:angular",
    "prettier": "catalog:",
    "rimraf": "6.1.3",
    "rxjs": "catalog:angular",
    "typescript": "catalog:",
    "zone.js": "catalog:angular"
  },
  "prettier": "@swisspost/design-system-prettier-config",
  "keywords": [
    "angular",
    "design-system",
    "components",
    "ui",
    "frontend"
  ]
}
