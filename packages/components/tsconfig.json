{
  "extends": "../../configs/typescript/tsconfig.stencil.json",
  "ts-node": {
    "compilerOptions": {
      "module": "node16",
      "moduleResolution": "node16"
    },
    "include": ["prebuild.ts", "prebuild.spec.ts"]
  },
  "compilerOptions": {
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["./*"]
    },
    "declaration": false,

    // Pre-existing debt. Drop once sources are clean.
    "strict": false,
    "noImplicitReturns": false
  },
  "include": [".config/*", "src", "types", "prebuild.spec.ts", "vrt/**/*", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
