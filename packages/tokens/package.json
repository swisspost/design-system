{
  "name": "@swisspost/design-system-tokens",
  "version": "10.4.0",
  "description": "Design Tokens for the Swiss Post Design System.",
  "author": "Swiss Post <design-system@post.ch>",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/swisspost/design-system.git"
  },
  "homepage": "https://design-system.post.ch",
  "bugs": {
    "url": "https://github.com/swisspost/design-system/issues"
  },
  "publishConfig": {
    "directory": "./dist",
    "access": "public",
    "linkDirectory": true
  },
  "scripts": {
    "build": "pnpm clean && tsc -p . && node ./dist/build.js && pnpm copy-files",
    "build:verbose": "pnpm clean && tsc -p . && node ./dist/build.js --verbosity=verbose && pnpm copy-files",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "copy-files": "copyfiles -f package.json README.md CONTRIBUTING.md CHANGELOG.md LICENSE *.scss dist"
  },
  "devDependencies": {
    "@swisspost/design-system-eslint-config": "workspace:10.4.0",
    "@swisspost/design-system-prettier-config": "workspace:10.4.0",
    "@swisspost/design-system-tsconfig": "workspace:10.4.0",
    "@tokens-studio/sd-transforms": "2.0.3",
    "@types/node": "catalog:node",
    "copyfiles": "2.4.1",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "6.1.3",
    "style-dictionary": "5.4.4",
    "typescript": "catalog:"
  },
  "prettier": "@swisspost/design-system-prettier-config",
  "keywords": [
    "tokens",
    "tokens studio",
    "scss",
    "design-system",
    "ui",
    "frontend"
  ]
}
