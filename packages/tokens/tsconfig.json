{
  "extends": "../../configs/typescript/tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "_build/*": ["./src/_build/*"]
    },

    // Pre-existing debt. Drop once sources are clean.
    "noImplicitReturns": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
