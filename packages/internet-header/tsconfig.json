{
  "extends": "../../configs/typescript/tsconfig.stencil.json",
  "compilerOptions": {
    "declaration": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["./*"]
    },

    // Pre-existing debt. Drop once sources are clean.
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
