{
  "name": "@swisspost/internet-header",
  "version": "10.8.0",
  "description": "The header for client facing applications.",
  "author": "Swiss Post <design-system@post.ch>",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/swisspost/design-system.git",
    "directory": "packages/internet-header"
  },
  "homepage": "https://design-system.post.ch",
  "bugs": {
    "url": "https://github.com/swisspost/design-system/issues"
  },
  "publishConfig": {
    "access": "public",
    "linkDirectory": true
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "main": "loader/index.cjs.js",
  "module": "loader/index.js",
  "es2017": "loader/index.es2017.js",
  "types": "loader/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/swisspost-internet-header/swisspost-internet-header.esm.js",
  "scripts": {
    "play": "stencil build --serve --port 9310 --watch --docs-readme --dev --config stencil.config.dev.ts",
    "start": "stencil build --watch --docs-readme",
    "build": "pnpm clean && pnpm typecheck && stencil build --docs-readme",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf www dist loader",
    "unit": "jest",
    "unit:watch": "jest --watch",
    "e2e": "cypress run",
    "e2e:watch": "cypress open",
    "e2e:ci": "xvfb-run -a cypress run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@swisspost/design-system-components": "workspace:10.8.0",
    "@swisspost/design-system-styles": "workspace:10.8.0"
  },
  "devDependencies": {
    "@percy/cypress": "3.1.9",
    "@stencil/core": "4.43.3",
    "@stencil/sass": "3.0.12",
    "@stencil/store": "2.0.16",
    "@swisspost/design-system-cypress-config": "workspace:10.8.0",
    "@swisspost/design-system-eslint-config": "workspace:10.8.0",
    "@swisspost/design-system-icons": "workspace:10.8.0",
    "@swisspost/design-system-prettier-config": "workspace:10.8.0",
    "@swisspost/design-system-tokens": "workspace:10.8.0",
    "@swisspost/design-system-tsconfig": "workspace:10.8.0",
    "@types/jest": "catalog:jest",
    "@types/node": "catalog:node",
    "cypress": "catalog:cypress",
    "cypress-each": "catalog:cypress",
    "cypress-storybook": "catalog:cypress",
    "eslint": "catalog:",
    "jest": "catalog:jest",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "catalog:",
    "rimraf": "6.1.4",
    "rollup-plugin-scss": "4.0.1",
    "sass": "1.104.0",
    "ts-jest": "catalog:jest",
    "typescript": "catalog:"
  },
  "prettier": "@swisspost/design-system-prettier-config",
  "keywords": [
    "components",
    "web-components",
    "header",
    "stencil",
    "design-system",
    "ui",
    "frontend"
  ]
}
